# Local coordinator REST API
DB_URL=jdbc:mysql://localhost:3306/distributed_scheduler?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
PORT=8080
GRPC_PORT=9090
# Generate a strong Base64-encoded secret (at least 32 random bytes) for JWT signing.
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
SCHEDULER_HEARTBEAT_TIMEOUT_SECONDS=15

# Worker environment (used by backend/worker)
COORDINATOR_HOST=localhost
COORDINATOR_GRPC_PORT=9090
WORKER_ID=worker-node-1
WORKER_HOSTNAME=localhost
WORKER_PORT=9091
WORKER_MAX_CONCURRENT_TASKS=5
WORKER_SUPPORTED_TASK_TYPES=LOGGING,ARITHMETIC,REPORT
